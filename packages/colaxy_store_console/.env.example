# Credentials for `dart run colaxy_store_console:verify` and the examples.
#
# Copy to .env, fill in what you have, and source it:
#
#     cp .env.example .env && $EDITOR .env
#     set -a && . ./.env && set +a
#     dart run colaxy_store_console:verify
#
# .env is git-ignored; .env.example is not, so keep this file empty of real
# values. Every surface is independent — leave the ones you are not using
# blank and the verifier skips them.

# --- App Store Connect ---------------------------------------------------
# Users and Access -> Integrations -> App Store Connect API, Team Keys tab.
# The .p8 downloads exactly once.
ASC_KEY_ID=
ASC_ISSUER_ID=
# The whole file: ASC_P8="$(cat AuthKey_XXXXXXXXXX.p8)"
ASC_P8=
# The number in the App Store Connect URL, not the bundle ID.
ASC_APP_ID=
# Payments and Financial Reports. Sales reports only. No API returns it.
ASC_VENDOR_NUMBER=

# --- Google Play ---------------------------------------------------------
# The service-account JSON: PLAY_KEY_JSON="$(cat play-api.json)"
PLAY_KEY_JSON=
PLAY_PACKAGE=
# Download reports -> "Copy Cloud Storage URI". Paste the whole thing.
# Report CSVs only. No API returns it.
PLAY_BUCKET=
